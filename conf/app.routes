# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /check-your-answers/:journeyId               controllers.CheckYourAnswersController.onPageLoad(journeyId: String)

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                controllers.UnauthorisedController.onPageLoad()

GET         /sa1                                         controllers.IndexController.startSA1()
GET         /cwf1st                                      controllers.IndexController.startCWF1ST()
GET         /cease-trading                               controllers.IndexController.startCeaseTrading()

GET         /sa1/start                                   controllers.sa1.StartController.onPageLoad()
POST        /sa1/start                                   controllers.sa1.StartController.onSubmit()

GET         /sa1/name/:journeyId                         controllers.sa1.NameController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST        /sa1/name/:journeyId                         controllers.sa1.NameController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET         /sa1/name/change/:journeyId                  controllers.sa1.NameController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST        /sa1/name/change/:journeyId                  controllers.sa1.NameController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET         /sa1/previous-last-name/:journeyId           controllers.sa1.AddPreviousLastNameController.onPageLoad(journeyId:String, mode: Mode = NormalMode)
POST        /sa1/previous-last-name/:journeyId           controllers.sa1.AddPreviousLastNameController.onSubmit(journeyId:String, mode: Mode = NormalMode)
GET         /sa1/previous-last-name/change/:journeyId    controllers.sa1.AddPreviousLastNameController.onPageLoad(journeyId:String, mode: Mode = CheckMode)
POST        /sa1/previous-last-name/change/:journeyId    controllers.sa1.AddPreviousLastNameController.onSubmit(journeyId:String, mode: Mode = CheckMode)

GET         /sa1/enter-previous-last-name/:journeyId     controllers.sa1.EnterPreviousLastNameController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST        /sa1/enter-previous-last-name/:journeyId     controllers.sa1.EnterPreviousLastNameController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET         /sa1/enter-previous-last-name/change/:journeyId     controllers.sa1.EnterPreviousLastNameController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST        /sa1/enter-previous-last-name/change/:journeyId     controllers.sa1.EnterPreviousLastNameController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET         /sa1/ni-number/:journeyId                    controllers.sa1.DoYouHaveANinoController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST        /sa1/ni-number/:journeyId                    controllers.sa1.DoYouHaveANinoController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET         /sa1/ni-number/change/:journeyId             controllers.sa1.DoYouHaveANinoController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST        /sa1/ni-number/change/:journeyId             controllers.sa1.DoYouHaveANinoController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET        /sa1/contact-details/:journeyId                        controllers.sa1.ContactDetailsController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST       /sa1/contact-details/:journeyId                        controllers.sa1.ContactDetailsController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET        /sa1/contact-details/change/:journeyId                  controllers.sa1.ContactDetailsController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST       /sa1/contact-details/change/:journeyId                 controllers.sa1.ContactDetailsController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET         /sa1/no-ni-number/:journeyId                        controllers.sa1.NoNinoReasonController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST        /sa1/no-ni-number/:journeyId                        controllers.sa1.NoNinoReasonController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET         /sa1/no-ni-number/change/:journeyId                 controllers.sa1.NoNinoReasonController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST        /sa1/no-ni-number/change/:journeyId                 controllers.sa1.NoNinoReasonController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET        /enter-ni-number/:journeyId                         controllers.sa1.EnterNationalInsuranceNumberController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST       /enter-ni-number/:journeyId                        controllers.sa1.EnterNationalInsuranceNumberController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET        /enter-ni-number/change/:journeyId                  controllers.sa1.EnterNationalInsuranceNumberController.onPageLoad(journeyId: String,mode: Mode = CheckMode)
POST       /enter-ni-number/change/:journeyId                  controllers.sa1.EnterNationalInsuranceNumberController.onSubmit(journeyId: String, mode: Mode = CheckMode)
GET        /sa1/enter-ni-number/:journeyId                         controllers.sa1.EnterNationalInsuranceNumberController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST       /sa1/enter-ni-number/:journeyId                        controllers.sa1.EnterNationalInsuranceNumberController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET        /sa1/enter-ni-number/change/:journeyId                  controllers.sa1.EnterNationalInsuranceNumberController.onPageLoad(journeyId: String,mode: Mode = CheckMode)
POST       /sa1/enter-ni-number/change/:journeyId                  controllers.sa1.EnterNationalInsuranceNumberController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET         /sa1/date-untaxed-income-director/:journeyId                        controllers.sa1.DateUntaxedIncomeDirectorController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST        /sa1/date-untaxed-income-director/:journeyId                        controllers.sa1.DateUntaxedIncomeDirectorController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET         /sa1/date-untaxed-income-director/change/:journeyId                 controllers.sa1.DateUntaxedIncomeDirectorController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST        /sa1/date-untaxed-income-director/change/:journeyId                 controllers.sa1.DateUntaxedIncomeDirectorController.onSubmit(journeyId: String, mode: Mode = CheckMode)

GET         /sa1/why-tax-return/:journeyId               controllers.sa1.WhyTaxReturnController.onPageLoad(journeyId: String, mode: Mode = NormalMode)
POST        /sa1/why-tax-return/:journeyId               controllers.sa1.WhyTaxReturnController.onSubmit(journeyId: String, mode: Mode = NormalMode)
GET         /sa1/why-tax-return/change/:journeyId        controllers.sa1.WhyTaxReturnController.onPageLoad(journeyId: String, mode: Mode = CheckMode)
POST        /sa1/why-tax-return/change/:journeyId        controllers.sa1.WhyTaxReturnController.onSubmit(journeyId: String, mode: Mode = CheckMode)
